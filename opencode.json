{
  "$schema": "https://opencode.ai/config.json",
  "model": "mistral/mistral-medium-2505",
  "provider": {
    "mistral": {
      "models": {
        "mistral-medium-2505": {
          "name": "Mistral Medium 2505 (128K ctx, chat/reasoning)"
        },
        "codestral-2508": {
          "name": "Codestral 2508 (coding specialist)"
        },
        "open-mistral-nemo": {
          "name": "Mistral Nemo (fast, 12B)"
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.mistral.ai/v1",
        "name": "Mistral"
      }
    },
    "cerebras": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.cerebras.ai/v1",
        "apiKey": "{env:CEREBRAS_API_KEY}"
      },
      "models": {
        "gemma-4-31b": {
          "name": "Gemma 4 31B (Cerebras fast inference)"
        },
        "zai-glm-4.7": {
          "name": "GLM 4.7 (Cerebras)"
        },
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B (Cerebras)"
        }
      }
    },
    "dashscope": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:DASHSCOPE_BASE_URL}",
        "apiKey": "{env:DASHSCOPE_API_KEY}"
      },
      "models": {
        "qwen3-coder-plus": {
          "name": "Qwen3 Coder Plus (coding)"
        },
        "qwen3.7-plus": {
          "name": "Qwen 3.7 Plus (chat/general)"
        },
        "qwen3.7-max": {
          "name": "Qwen 3.7 Max (reasoning)"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (fast)"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (reasoning)"
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "qwen/qwen3-next-80b-a3b-instruct:free": {
          "name": "Qwen3 Next 80B (free, rate-limited)"
        },
        "google/gemma-4-31b-it:free": {
          "name": "Gemma 4 31B (free, rate-limited)"
        },
        "nvidia/nemotron-3-super-120b-a12b:free": {
          "name": "Nemotron 3 Super 120B (free)"
        },
        "openai/gpt-oss-20b:free": {
          "name": "GPT-OSS 20B (free)"
        }
      }
    },
    "aihubmix": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://aihubmix.com/v1",
        "apiKey": "{env:AIHUBMIX_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2 (AIHubMix, paid)"
        },
        "glm-4.7-flash-free": {
          "name": "GLM 4.7 Flash (AIHubMix, free tier limited)"
        },
        "coding-glm-4.6-free": {
          "name": "GLM 4.6 Coding (AIHubMix, free tier limited)"
        },
        "coding-glm-5.2-free": {
          "name": "GLM 5.2 Coding (AIHubMix, free — 10 req without balance)"
        },
        "coding-kimi-k3-free": {
          "name": "Kimi K3 Coding (AIHubMix, free — 1M context, 73 TPS)"
        },
        "gpt-5.5-free": {
          "name": "GPT 5.5 (AIHubMix, free via Azure — content filter ON)"
        }
      }
    },
    "huggingface": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://router.huggingface.co/v1",
        "apiKey": "{env:HUGGINGFACE_API_KEY}"
      },
      "models": {
        "Qwen/Qwen3.6-27B": {
          "name": "Qwen3.6 27B (HF Serverless)"
        },
        "deepseek-ai/DeepSeek-V4-Flash": {
          "name": "DeepSeek V4 Flash (HF)"
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "deepseek-ai/deepseek-r1": {
          "name": "DeepSeek R1 (Nvidia NIM)"
        }
      }
    },
    "sambanova": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.sambanova.ai/v1",
        "apiKey": "{env:SAMBANOVA_API_KEY}"
      },
      "models": {
        "DeepSeek-V3.2": {
          "name": "DeepSeek V3.2 (Sambanova, fast)"
        },
        "Meta-Llama-3.3-70B-Instruct": {
          "name": "Llama 3.3 70B (Sambanova)"
        },
        "gemma-4-31B-it": {
          "name": "Gemma 4 31B (Sambanova)"
        },
        "gpt-oss-120b": {
          "name": "GPT-OSS 120B (Sambanova)"
        }
      }
    },
    "groq": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.groq.com/openai/v1",
        "apiKey": "{env:GROQ_API_KEY}"
      },
      "models": {
        "qwen/qwen3.6-27b": {
          "name": "Qwen3.6 27B (Groq, ultra-fast ✅)"
        },
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B (Groq, fast ✅)"
        },
        "openai/gpt-oss-20b": {
          "name": "GPT-OSS 20B (Groq, fast ✅)"
        },
        "llama-3.3-70b-versatile": {
          "name": "Llama 3.3 70B (Groq, fast ✅)"
        },
        "llama-4-scout": {
          "name": "Llama 4 Scout 17B (Groq, fast)"
        }
      }
    },
    "llama_server": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8080/v1",
        "apiKey": "not-needed"
      },
      "_note": "Local Qwen2.5-Coder-7B. Start: llama-server -m <model> --port 8080",
      "models": {
        "qwen2.5-coder-7b-instruct-q5_k_m": {
          "name": "Qwen2.5-Coder-7B Q5 (local, port 8080)"
        }
      }
    },
    "qwythos_local": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8081/v1",
        "apiKey": "not-needed"
      },
      "_note": "Local Qwythos-9B for audit/reasoning. Start: llama-server -m <model> --port 8081",
      "models": {
        "Qwythos-9B-Claude-Mythos-5-1M-Q4_K_M": {
          "name": "Qwythos-9B Claude Mythos 5 (local reasoning, port 8081)"
        }
      }
    },
    "pollinations": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://text.pollinations.ai/openai",
        "apiKey": "not-needed"
      },
      "models": {
        "openai": {
          "name": "Pollinations text (zero-auth emergency fallback)"
        }
      }
    }
  },
  "agent": {
    "planner": {
      "description": "Декомпозиция фичи в JSON task graph.",
      "mode": "subagent",
      "prompt": "{file:/home/ekzent/.swarm/agents/planner.md}",
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0.6,
      "permission": {
        "edit": "ask",
        "bash": "ask"
      },
      "hidden": true
    },
    "coder": {
      "description": "Реализация в file scope. Ponytail ladder.",
      "mode": "subagent",
      "prompt": "{file:/home/ekzent/.swarm/agents/coder.md}",
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0.3,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "hidden": true
    },
    "reviewer": {
      "description": "OWASP Top 10, structured findings.",
      "mode": "subagent",
      "prompt": "{file:/home/ekzent/.swarm/agents/reviewer.md}",
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0.4,
      "permission": {
        "edit": "ask",
        "bash": "ask"
      },
      "hidden": true
    },
    "tester": {
      "description": "TDD red phase first. AAA pattern.",
      "mode": "subagent",
      "prompt": "{file:/home/ekzent/.swarm/agents/tester.md}",
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0.4,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "hidden": true
    },
    "debugger": {
      "description": "Root cause, 1-5 строк fix.",
      "mode": "subagent",
      "prompt": "{file:/home/ekzent/.swarm/agents/debugger.md}",
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0.3,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "hidden": true
    },
    "researcher": {
      "description": "Look up APIs. Цитаты с source URL.",
      "mode": "subagent",
      "prompt": "{file:/home/ekzent/.swarm/agents/researcher.md}",
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0.5,
      "permission": {
        "edit": "ask",
        "bash": "ask"
      },
      "hidden": true
    },
    "judge": {
      "description": "Litmus Test. Rubric 0-100. Honesty.",
      "mode": "subagent",
      "prompt": "{file:/home/ekzent/.swarm/agents/judge.md}",
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0.3,
      "permission": {
        "edit": "ask",
        "bash": "ask"
      },
      "hidden": true
    },
    "resolver": {
      "description": "Git merge conflicts.",
      "mode": "subagent",
      "prompt": "{file:/home/ekzent/.swarm/agents/resolver.md}",
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0.4,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "hidden": true
    },
    "builder": {
      "description": "Production build, CVE scan, CI/CD.",
      "mode": "subagent",
      "prompt": "{file:/home/ekzent/.swarm/agents/builder.md}",
      "model": "opencode/deepseek-v4-flash-free",
      "temperature": 0.5,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "hidden": true
    },
    "coordinator": {
      "description": "Coordinator — AI-ментор и оркестратор. Единственный видимый агент.",
      "mode": "primary",
      "prompt": "{file:/home/ekzent/.swarm/agents/coordinator.md}",
      "model": "opencode/big-pickle",
      "temperature": 0.7,
      "steps": 50,
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "rm -rf *": "deny",
          "git push --force": "deny",
          "drop table": "deny"
        },
        "task": {
          "*": "deny",
          "planner": "allow",
          "coder": "allow",
          "reviewer": "allow",
          "tester": "allow",
          "qa_tester": "allow",
          "debugger": "allow",
          "researcher": "allow",
          "judge": "allow",
          "resolver": "allow",
          "builder": "allow",
          "spec_agent": "allow",
          "security_auditor": "allow",
          "smart_contract_auditor": "allow",
          "crypto_reviewer": "allow",
          "penetration_tester": "allow",
          "ux_tester": "allow",
          "error_detective": "allow",
          "prompt_engineer": "allow",
          "performance_engineer": "allow"
        }
      }
    },
    "spec_agent": {
      "description": "Помогает написать PRD. Интерактивный interview.",
      "mode": "subagent",
      "prompt": "{file:/home/ekzent/.swarm/agents/spec_agent.md}",
      "model": "opencode/deepseek-v4-flash-free",
