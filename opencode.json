  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "plugin": [
    "@dietrichgebert/ponytail",
    "@tarquinen/opencode-dcp"
  ],
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@anthropic/opencode-context7"
      ]
    },
    "sqz": {
      "command": [
        "sqz-mcp",
        "--transport",
        "stdio"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "compaction": {
    "auto": true,
    "prune": false
  }
}